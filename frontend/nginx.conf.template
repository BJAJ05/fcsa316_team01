# nginx config for the React app. ${BACKEND_URL} is replaced at container start;
# nginx's own variables ($uri, $http_host, ...) are left as they are.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # API calls, the Django admin and its static files go to the Django backend,
    # so the browser sees one site (no CORS needed).
    location ~ ^/(api|admin|static)/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else is the React app. Unknown paths (e.g. /teacher) get index.html,
    # and React Router shows the right page.
    location / {
        try_files $uri /index.html;
    }
}
