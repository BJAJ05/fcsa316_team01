# Copy this file to `.env` (same folder) and edit the values for your machine.
# `.env` is ignored by git, so your password stays on your computer.

# Any long random string. For local development the value below is fine.
DJANGO_SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (see "PostgreSQL суулгах" in backend/README.md).
DB_ENGINE=postgres
DB_NAME=lms_db
DB_USER=lms_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Before PostgreSQL is installed you can temporarily use SQLite instead:
# DB_ENGINE=sqlite
